{
  "name": "quicktone-web-controller",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack LAN Web Controller for NUX MG-300 backed by local QuickTone preset configurations",
  "workspaces": [
    "packages/shared",
    "packages/quicktone-reader",
    "packages/midi-service",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dev:backend": "npm --workspace=@quicktone/backend run dev",
    "dev:frontend": "npm --workspace=@quicktone/frontend run dev",
    "start": "npm --workspace=@quicktone/backend run start"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fastify": "^5.2.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  }
}
